generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProjectFileCategory {
  MODEL
  DRAWING
  SCHEDULE
  COST
  CONTRACT
  OTHER
}

enum ProjectFileStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model User {
  id                   String         @id @default(cuid())
  phone                String?        @unique
  account              String         @unique
  username             String?
  displayName          String?
  role                 UserRole       @default(MEMBER)
  passwordHash         String?
  isProfileCompleted   Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  refreshTokens        RefreshToken[]
  projects             Project[]
  uploadedFiles        ProjectFile[]   @relation("UploadedFiles")

  @@index([phone])
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files       ProjectFile[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model ProjectFile {
  id               String              @id @default(cuid())
  projectId        String
  uploadedById     String
  originalFileName String
  storedFileName   String
  mimeType         String?
  fileSize         Int
  storageBucket    String
  storageKey       String
  category         ProjectFileCategory
  status           ProjectFileStatus   @default(PENDING)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy       User                @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([uploadedById])
  @@index([status])
  @@index([category])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  jti        String   @unique
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SmsCode {
  id         String   @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}
