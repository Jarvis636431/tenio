{
  "name": "tenio",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:shared": "pnpm --filter @tenio/shared typecheck",
    "build:all": "pnpm build:shared && pnpm build:web && pnpm build:api",
    "lint": "pnpm --filter web lint",
    "lint:web": "pnpm --filter web lint",
    "lint:api": "pnpm --filter api lint",
    "lint:all": "pnpm lint:web && pnpm lint:api",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm test:web",
    "test:web": "pnpm --filter web test",
    "test:api": "pnpm --filter api test",
    "test:all": "pnpm test:web && pnpm test:api",
    "typecheck": "pnpm typecheck:web",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:api": "pnpm --filter api typecheck",
    "typecheck:shared": "pnpm --filter @tenio/shared typecheck",
    "typecheck:all": "pnpm typecheck:shared && pnpm typecheck:web && pnpm typecheck:api",
    "check": "pnpm check:all",
    "check:web": "pnpm --filter web check",
    "check:api": "pnpm --filter api check",
    "check:shared": "pnpm --filter @tenio/shared typecheck",
    "check:all": "pnpm check:shared && pnpm check:web && pnpm check:api",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter web exec eslint --fix",
      "pnpm --filter web exec prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
